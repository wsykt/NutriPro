# ============================================================
# AI 服务环境变量模板
# 用法：复制本文件为 .env 并填写实际值（.env 不入库）
# 注意：保持键名与 .env 一致；修改任一服务端口时需同步 start_all.ps1
# ============================================================

# ---- LLM 配置（云端 DeepSeek）----
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek Responses API（语义化流式；默认开启，仅 deepseek-v4-flash 支持）
RESPONSES_API_ENABLED=true
RESPONSES_API_BASE=https://api.deepseek.com
RESPONSES_MODEL=deepseek-v4-flash

# ---- LLM 模式：cloud（云端 DeepSeek）/ local（本地 Ollama）----
LLM_MODE=cloud

# ---- 本地 Ollama（LLM_MODE=local 时生效）----
OLLAMA_MODEL=qwen2.5-7b-local:latest

# ---- 可选：通义千问视觉模型（当前 .env 未启用，按需放开）----
# QWEN_API_KEY=your-qwen-api-key
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_VL_MODEL=qwen-vl-plus

# ---- 向量模型 ----
EMBEDDING_MODEL_NAME=./models/bge-base-zh-v1.5
EMBEDDING_DIM=768

# ---- 存储路径 ----
CHROMA_DB_PATH=./knowledge/chroma_db_storage
DATA_DIR=./data

# ---- 服务端口（与 start_all.ps1 保持一致）----
AI_SERVICE_PORT=8002
