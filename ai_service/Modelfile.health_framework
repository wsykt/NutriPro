# 适配G15 RTX3060 6G显存的Modelfile
# 基于 qwen2.5:7b-instruct-q4_K_M 创建优化版本
# 用途：本地搭框架 + 格式校验（Stage 1/3）

FROM qwen2.5:7b-instruct-q4_K_M

# ========== 核心防溢出参数（6G显存安全配置）==========
# 上下文窗口：2048（禁止开8k，防止显存溢出闪退）
PARAMETER num_ctx 2048
# 单次生成最大token：1500（不超过num_ctx的75%，留余量给系统提示词）
PARAMETER num_predict 1500

# ========== 框架搭建专属参数（低温度保严谨）==========
# 温度：0.3（低温度输出严谨，适合搭框架锁格式）
PARAMETER temperature 0.3
# top_k：25（限制候选词范围，提升输出稳定性）
PARAMETER top_k 25
# top_p：0.9（核采样，配合温度平衡严谨性和合理性）
PARAMETER top_p 0.9
# 重复惩罚：1.1（避免模型重复输出标签）
PARAMETER repeat_penalty 1.1

# ========== 系统提示词（框架搭建专属）==========
SYSTEM """
你是一位严谨的营养学科普编辑，负责搭建文章框架。
严格固定文章板块标签，板块顺序不可调换、标签字符不允许修改。
【#标记名#】必须独占完整一行，必须使用【】符号包裹。
仅基于提供的本地知识库素材搭建框架，不引入外部文献。
禁止使用绝对化表述。涉及疾病膳食建议需标注咨询医生或营养师。
"""
